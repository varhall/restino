{
	"name": "varhall/restino",
	"type": "library",
	"description": "Nette REST API Library",
	"keywords": ["nette", "rest", "api"],
	"homepage": "https://github.com/varhall/restino",
	"license": "MIT",
        "authors": [
		{
			"name": "Ondrej Sibrava",
			"homepage": "https://www.varhall.cz"
		}
	],
	"support": {
		"issues": "https://github.com/varhall/restino"
	},

	"require": {
		"php": ">=8.1",
		"nette/di": ">=v3.1",
		"nette/application": ">=v3.1",
		"nette/http": ">=v3.2",
		"nette/security": ">=v3.1",
		"varhall/utilino": "^v1.2"
	},

	"require-dev": {
		"mockery/mockery": "^1.6",
		"nette/database": "^3.2",
		"ninjify/nunjuck": "^v0.4",
		"phpstan/phpstan": "^2.1",
		"varhall/dbino": "^2.0"
	},

	"suggest": {
		"nette/database": "Collections and filtering of Nette Database selections",
		"varhall/dbino": "Collections, ordering and filtering of Dbino models",
		"phpstan/phpstan": "Checks of ClientVersion::before() branches (phpstan/extension.neon)"
	},

	"autoload": {
		"psr-4": {
			"Varhall\\Restino\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests"
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
